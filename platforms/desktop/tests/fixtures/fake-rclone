#!/bin/sh
set -eu

command_name="${1:-}"
shift || true

case "$command_name" in
  version)
    printf '%s\n' 'rclone v1.99.0-fixture' '- os/version: test' '- os/arch: test'
    ;;
  listremotes)
    printf '%s\n' '[{"name":"fixture","type":"drive","description":"Integration fixture"}]'
    ;;
  lsjson)
    recursive=0
    for argument in "$@"; do
      [ "$argument" = "--recursive" ] && recursive=1
    done
    if [ "$recursive" -eq 1 ]; then
      printf '%s\n' '[{"Path":"Docs/notes.txt","Name":"notes.txt","Size":21,"MimeType":"text/plain","ModTime":"2026-08-13T00:00:00Z","IsDir":false},{"Path":"photo.jpg","Name":"photo.jpg","Size":42,"MimeType":"image/jpeg","ModTime":"2026-08-13T01:00:00Z","IsDir":false}]'
    else
      printf '%s\n' '[{"Path":"Docs","Name":"Docs","Size":-1,"MimeType":"inode/directory","ModTime":"2026-08-13T00:00:00Z","IsDir":true},{"Path":"readme.txt","Name":"readme.txt","Size":12,"MimeType":"text/plain","ModTime":"2026-08-13T01:00:00Z","IsDir":false}]'
    fi
    ;;
  link)
    printf '%s\n' 'https://example.invalid/public-link'
    ;;
  size)
    printf '%s\n' '{"count":3,"bytes":75}'
    ;;
  tree)
    printf '%s\n' '/' '└── Docs' '    └── Archive'
    ;;
  selfupdate)
    printf '%s\n' \
      'yours: 1.99.0-fixture' \
      'latest: 1.99.0-fixture (released 2026-08-01)' \
      'upgrade: https://downloads.example.invalid/v1.99.0-fixture' \
      'beta:' \
      '2.0.0-beta.1 (released 2026-08-14)' \
      'upgrade: https://beta.example.invalid/v2.0.0-beta.1'
    ;;
  cat)
    printf '%s' 'fixture stream bytes'
    ;;
  copy|copyto|move|moveto|sync)
    for argument in "$@"; do
      [ "$argument" = "fixture:slow" ] && sleep 10
    done
    printf '%s\n' '{"level":"notice","msg":"Transferring","stats":{"bytes":75,"totalBytes":75,"speed":75.0,"eta":0}}' >&2
    ;;
  mount)
    printf '%s\n' 'fixture mount ready' >&2
    ;;
  config)
    config_command="${1:-}"
    case "$config_command" in
      providers)
        printf '%s\n' '[{"Name":"fixture","Description":"Fixture Storage","Prefix":"fixture","Hide":false},{"Name":"hidden","Description":"Hidden Storage","Prefix":"hidden","Hide":true}]'
        ;;
      create|update)
        continued=0
        for argument in "$@"; do
          [ "$argument" = "--continue" ] && continued=1
        done
        if [ "$continued" -eq 1 ]; then
          printf '%s\n' '{"State":"","Option":null,"Error":"","Result":""}'
        else
          printf '%s\n' '{"State":"fixture-question","Option":{"Name":"endpoint","Help":"Fixture endpoint","DefaultStr":"https://example.invalid","ValueStr":"","Required":true,"IsPassword":false,"Exclusive":false,"Sensitive":false,"Type":"string","Examples":[]},"Error":"","Result":""}'
        fi
        ;;
      delete)
        ;;
      file)
        printf '%s\n' 'Configuration file is stored at:' '/tmp/rclone-fixture.conf'
        ;;
    esac
    ;;
  mkdir|purge|delete|deletefile)
    ;;
  *)
    printf 'unsupported fixture command: %s\n' "$command_name" >&2
    exit 64
    ;;
esac
