{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rclone Browser",
  "version": "2.0.2",
  "identifier": "io.github.rclone-browser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rclone Browser",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Browse and transfer files with rclone",
    "longDescription": "A modern cross-platform desktop interface for browsing and managing rclone remotes.",
    "icon": [
      "../../../assets/icons/32x32.png",
      "../../../assets/icons/128x128.png",
      "../../../assets/icons/256x256.png",
      "../../../assets/icons/512x512.png",
      "../../../assets/icons/app-icon.icns",
      "../../../assets/icons/app-icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
